{
  "name": "@screentools/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Windows 本机显示器管理工具，通过 Win32 CCD 与 DDC/CI 控制显示设备。",
  "author": "yosong",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "build:unpack": "pnpm build && electron-builder --win --x64 --dir --publish never",
    "build:win": "pnpm build && electron-builder --win --x64 --publish never",
    "build:mac": "pnpm build && electron-builder --mac --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@screentools/contracts": "workspace:*",
    "@screentools/display-control": "workspace:*",
    "@screentools/display-native": "workspace:*",
    "koffi": "3.3.3",
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
